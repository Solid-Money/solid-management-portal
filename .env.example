NEXT_PUBLIC_ALLOWED_DOMAIN=fuse.io

# Temporal dashboard, for the "Workflow" links on a user's deposits.
#
# The namespace is what turns the links on: without it the workflow id is shown
# as copyable plain text instead, since a link into a namespace that does not
# exist is worse than none. Temporal Cloud namespaces are qualified with the
# account id — take it from the URL of any workflow in the dashboard:
#   https://cloud.temporal.io/namespaces/solid-backend-prod.s9x48/workflows/...
#                                        ^^^^^^^^^^^^^^^^^^^^^^^
NEXT_PUBLIC_TEMPORAL_NAMESPACE=
# Defaults to Temporal Cloud; point it at your own UI if self-hosting.
NEXT_PUBLIC_TEMPORAL_UI_BASE_URL=https://cloud.temporal.io

BLOB_READ_WRITE_TOKEN=

# Branch of Solid-Money/solid-ui the "Latest" app-version lookup reads
# app.config.ts from. Defaults to master on Vercel production and qa elsewhere.
SOLID_UI_BRANCH=

# Metabase public dashboard tokens, for the legacy embeds under
# Analytics → Signals → Legacy embeds.
#
# A public token is an unauthenticated URL: anyone holding one can read that
# dashboard without signing in, which is why they belong in env rather than in
# the bundle. Leave a token blank and its tab is hidden rather than rendering a
# broken iframe. These retire with Phase 2, when the panels they show are built
# from the analytics endpoints.
NEXT_PUBLIC_METABASE_TOKEN_DEPOSITS=
NEXT_PUBLIC_METABASE_TOKEN_CARD=
NEXT_PUBLIC_METABASE_TOKEN_REFERRALS=
NEXT_PUBLIC_METABASE_TOKEN_POINTS=
